{
  "extends": "./tsconfig.base.json",

  "compilerOptions": {
    /* Project */
    "rootDir": "./src",

    /* Language */
    "lib": ["ES2025", "DOM", "DOM.Iterable"],

    /* JSX */
    "jsx": "react-jsx",

    /* Declaration Files */
    "declaration": true,
    "declarationMap": true
  },

  "include": ["src"]
}
