{
  "name": "@beautinique/packages",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Beautinique packages.",
  "keywords": [
    "beautinique",
    "monorepo",
    "packages",
    "typescript",
    "npm"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*/*"
  ],
  "scripts": {
    "build": "node ./scripts/build-order/index.mjs",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "clean": "node ./scripts/clean/index.mjs",
    "create": "node ./scripts/create/index.mjs",
    "publish": "node ./scripts/publish/index.mjs",
    "republish": "node ./scripts/republish/index.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "inquirer": "^14.2.3",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
