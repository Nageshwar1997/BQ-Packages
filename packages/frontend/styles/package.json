{
  "name": "@beautinique/frontend-styles",
  "version": "1.0.0",
  "description": "Shared Tailwind v4 theme, base styles and utilities for the Beautinique frontends.",
  "keywords": [
    "frontend",
    "styles",
    "css",
    "tailwind",
    "beautinique"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/BQ-Packages.git",
    "directory": "packages/frontend/styles"
  },
  "bugs": {
    "url": "https://github.com/Nageshwar1997/BQ-Packages/issues"
  },
  "homepage": "https://github.com/Nageshwar1997/BQ-Packages/tree/main/packages/frontend/styles#readme",
  "type": "module",
  "style": "./src/index.css",
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "style": "./src/index.css",
      "default": "./src/index.css"
    },
    "./index.css": "./src/index.css",
    "./variables.css": "./src/variables.css",
    "./fonts.css": "./src/fonts.css",
    "./global.css": "./src/global.css",
    "./component.css": "./src/component.css",
    "./animations.css": "./src/animations.css",
    "./utility.css": "./src/utility.css",
    "./teddy.css": "./src/teddy.css",
    "./color-input.css": "./src/color-input.css",
    "./quill-input.css": "./src/quill-input.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ./check.mjs",
    "lint": "prettier --check src",
    "typecheck": "node ./check.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@tailwindcss/typography": "^0.5.0",
    "tailwindcss": "^4.0.0"
  }
}
