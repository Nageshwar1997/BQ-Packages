{
  "name": "@beautinique/frontend-tryon",
  "version": "1.0.6",
  "description": "The virtual try-on of the Beautinique frontends: live camera or photo, for lips, face, eyes, hair and nails.",
  "keywords": [
    "frontend",
    "react",
    "tryon",
    "mediapipe",
    "makeup",
    "beautinique"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/BQ-Packages.git",
    "directory": "packages/frontend/tryon"
  },
  "bugs": {
    "url": "https://github.com/Nageshwar1997/BQ-Packages/issues"
  },
  "homepage": "https://github.com/Nageshwar1997/BQ-Packages/tree/main/packages/frontend/tryon#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "source.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js",
      "require": "./dist/constants/index.cjs",
      "default": "./dist/constants/index.js"
    },
    "./modal": {
      "types": "./dist/modal/index.d.ts",
      "import": "./dist/modal/index.js",
      "require": "./dist/modal/index.cjs",
      "default": "./dist/modal/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js",
      "require": "./dist/vite/index.cjs",
      "default": "./dist/vite/index.js"
    },
    "./source.css": "./source.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node ../../../scripts/build-types/index.mjs",
    "dev": "tsup --watch",
    "playground": "vite --config playground/vite.config.ts",
    "lint": "eslint .",
    "test": "vitest run --environment jsdom",
    "test:watch": "vitest --environment jsdom",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@beautinique/frontend-constants": "^1.1.2",
    "@beautinique/frontend-types": "^1.1.2",
    "@beautinique/shared-utils": "^1.1.2",
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "peerDependencies": {
    "@beautinique/frontend-components": "^1.0.12",
    "@beautinique/frontend-styles": "^1.1.2",
    "@iconify/react": "^6.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@beautinique/frontend-components": "^1.0.12",
    "@beautinique/frontend-styles": "^1.1.2",
    "@beautinique/frontend-tryon-assets": "^1.0.2",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "canvas": "^3.2.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
