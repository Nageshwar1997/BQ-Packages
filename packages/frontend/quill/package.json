{
  "name": "@beautinique/frontend-quill",
  "version": "1.0.0",
  "description": "The rich-text editor and the safe viewer of the Beautinique frontends: Quill with image uploads held back until save, and sanitized HTML.",
  "keywords": [
    "frontend",
    "react",
    "quill",
    "rich text editor",
    "wysiwyg",
    "dompurify",
    "beautinique"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/BQ-Packages.git",
    "directory": "packages/frontend/quill"
  },
  "bugs": {
    "url": "https://github.com/Nageshwar1997/BQ-Packages/issues"
  },
  "homepage": "https://github.com/Nageshwar1997/BQ-Packages/tree/main/packages/frontend/quill#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "source.css"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js",
      "require": "./dist/editor/index.cjs",
      "default": "./dist/editor/index.js"
    },
    "./source.css": "./source.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node ../../../scripts/build-types/index.mjs",
    "dev": "tsup --watch",
    "playground": "vite --config playground/vite.config.ts",
    "lint": "eslint .",
    "test": "vitest run --environment jsdom",
    "test:watch": "vitest --environment jsdom",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@beautinique/frontend-constants": "^1.1.2",
    "@beautinique/shared-utils": "^1.1.2",
    "dompurify": "^3.4.17",
    "nanoid": "^6.0.2"
  },
  "peerDependencies": {
    "@beautinique/frontend-styles": "^1.1.2",
    "quill": "^2.0.3",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "quill": {
      "optional": true
    }
  },
  "devDependencies": {
    "@beautinique/frontend-styles": "^1.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "quill": "^2.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
