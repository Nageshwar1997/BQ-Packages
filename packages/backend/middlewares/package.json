{
  "name": "@beautinique/backend-middlewares",
  "version": "1.0.0",
  "description": "Backend middlewares for Beautinique project.",
  "keywords": [
    "backend",
    "middlewares",
    "beautinique"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/BQ-Packages.git",
    "directory": "packages/backend/middlewares"
  },
  "bugs": {
    "url": "https://github.com/Nageshwar1997/BQ-Packages/issues"
  },
  "homepage": "https://github.com/Nageshwar1997/BQ-Packages/tree/main/packages/backend/middlewares#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./cors": {
      "types": "./dist/cors.d.ts",
      "import": "./dist/cors.js",
      "require": "./dist/cors.cjs",
      "default": "./dist/cors.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js",
      "require": "./dist/session.cjs",
      "default": "./dist/session.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "cors": "^2.8.6",
    "mongoose": "^9.7.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@beautinique/backend-classes": "^1.0.1"
  },
  "peerDependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mongoose": "^9.7.3"
  },
  "peerDependenciesMeta": {
    "cors": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    }
  }
}
