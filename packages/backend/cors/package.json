{
  "name": "@beautinique/backend-cors",
  "version": "1.0.6",
  "description": "Cors middleware for Beautinique project.",
  "keywords": [
    "cors",
    "backend",
    "beautinique",
    "middleware"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/BQ-Packages.git",
    "directory": "packages/backend/cors"
  },
  "bugs": {
    "url": "https://github.com/Nageshwar1997/BQ-Packages/issues"
  },
  "homepage": "https://github.com/Nageshwar1997/BQ-Packages/tree/main/packages/backend/cors#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node ../../../scripts/build-types/index.mjs",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@beautinique/backend-classes": "^1.0.6",
    "cors": "^2.8.6"
  },
  "peerDependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "typescript": "^6.0.3"
  }
}
