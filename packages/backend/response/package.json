{
  "name": "@beautinique/backend-response",
  "version": "1.0.7",
  "description": "Backend Request middleware for Beautinique project.",
  "keywords": [
    "backend",
    "response",
    "middleware",
    "express",
    "mongoose",
    "beautinique"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/BQ-Packages.git",
    "directory": "packages/backend/response"
  },
  "bugs": {
    "url": "https://github.com/Nageshwar1997/BQ-Packages/issues"
  },
  "homepage": "https://github.com/Nageshwar1997/BQ-Packages/tree/main/packages/backend/response#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "public"
  ],
  "sideEffects": [
    "./src/globals.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node ../../../scripts/build-types/index.mjs",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@beautinique/backend-classes": "^1.0.7",
    "@beautinique/backend-utils": "^1.0.9"
  },
  "peerDependencies": {
    "express": "^5.2.1"
  }
}
